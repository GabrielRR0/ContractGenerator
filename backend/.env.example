SUPABASE_URL=
SUPABASE_KEY=
# URL del frontend desplegado (produccion), para habilitarla en CORS.
# Ej: https://contract-generator-tuusuario.vercel.app
FRONTEND_URL=

# Backend de almacenamiento del rate limiter. "memory://" (default) alcanza
# para un solo proceso; en serverless con varias instancias corriendo en
# paralelo cada una cuenta por separado, asi que el limite deja de ser
# estricto. Para un limite global real, usar Redis (Upstash tiene free tier):
# RATE_LIMIT_STORAGE_URI=redis://default:<password>@<host>:<port>
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_GENERATE=10/minute
RATE_LIMIT_PREVIEW=90/minute
RATE_LIMIT_READ=60/minute
MAX_BODY_BYTES=50000
